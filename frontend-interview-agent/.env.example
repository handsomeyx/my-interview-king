# AI 服务配置
# mock: 本地模拟回答（开发测试用，无需 Key）
# zhipu: 智谱 AI（永久免费 2000 万 Token，中文优化好）
# ollama: Ollama 本地部署（完全免费，需本地运行 Ollama 服务）
AI_PROVIDER=mock

# 智谱 AI 配置（https://open.bigmodel.cn/）
# 注册后在控制台获取 API Key：https://open.bigmodel.cn/usercenter/apikeys
AI_API_KEY=
# 可选模型：glm-4-flash（默认，免费）、glm-4-air、glm-4-long
AI_MODEL=glm-4-flash

# Ollama 本地部署配置
# 1. 安装 Ollama: https://ollama.com/download
# 2. 拉取模型: ollama pull qwen2.5:7b
# 3. 启动服务: ollama serve
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b

# 请求超时（秒）
AI_TIMEOUT=30
